<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
  const CXT = '<c:out value="${pageContext.request.contextPath}"/>';

  // Notify nhỏ đơn giản
  function note(msg, ok = true) {
    let wrap = document.getElementById('note-wrap');
    if (!wrap) {
      wrap = document.createElement('div');
      wrap.id = 'note-wrap';
      Object.assign(wrap.style, {position:'fixed',right:'20px',bottom:'20px',zIndex:'20000'});
      document.body.appendChild(wrap);
    }
    const el = document.createElement('div');
    el.textContent = msg;
    Object.assign(el.style, {
      minWidth:'220px',maxWidth:'320px',marginTop:'8px',padding:'10px 12px',
      borderRadius:'10px',boxShadow:'0 6px 24px rgba(0,0,0,.15)',color:'#fff',
      background: ok ? '#2fa684' : '#e55353', fontSize:'14px'
    });
    wrap.appendChild(el);
    setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; }, 2200);
    setTimeout(() => el.remove(), 2600);
  }

  // Làm tươi phần body của mini-cart (fragment)
  async function refreshMiniCart() {
    const body = document.getElementById('miniCartBody');
    if (!body) return;
    try {
      const html = await fetch(CXT + '/cart?fragment=1', {cache:'no-store'}).then(r => r.text());
      body.innerHTML = html;
    } catch (_) { /* ignore */ }
  }

  // POST form x-www-form-urlencoded
  async function postForm(url, obj) {
    const prms = new URLSearchParams();
    Object.keys(obj).forEach(k => prms.set(k, obj[k]));
    const res = await fetch(url, {
      method: 'POST',
      headers: {'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'},
      body: prms.toString()
    });
    return res.json();
  }

  // Thêm vào giỏ: nút .btn-add-to-cart ở Home/Products
  document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-add-to-cart');
    if (!btn) return;

    // Nếu thiếu data-id -> để hành vi cũ (reload) hoạt động
    const id = btn.dataset.id;
    if (!id) return;

    e.preventDefault();
    try {
      const d = await postForm(CXT + '/cart', { action:'add', id });
      if (d && (d.ok || typeof d.count !== 'undefined' || typeof d.totalQty !== 'undefined')) {
        if (typeof window.setMiniCartCount === 'function') {
          window.setMiniCartCount(d.count ?? d.totalQty ?? 0);
        }
        await refreshMiniCart();
        note('Đã thêm vào giỏ hàng!');
      } else {
        note('Không thể thêm sản phẩm.', false);
      }
    } catch {
      note('Lỗi kết nối, thử lại sau.', false);
    }
  });

  // Expose để nơi khác gọi khi cần
  window.refreshMiniCart = refreshMiniCart;

})();
</script>